# Attende-ai environment. Copy to `.env.local` for local work and fill in. Never commit real values.

# --- Attende API (served by this app: app/api, server/) ---------------------
# The Attende MongoDB (plans, signups, billing, agent setups, automations). Not the JSYNQ database (MONGODB_URI).
ATTENDE_MONGODB_URI=
# Optional: origin of this app, the only billing-portal return origin. Defaults to AUTH_URL.
FRONTEND_URL=
# Public origin of this app; JSYNQ calls <PUBLIC_URL>/api/jsynq/webhooks and /api/jsynq/inbound. Used by the scripts.
PUBLIC_URL=
# 32 bytes in base64: seals a pending signup's password until the e-mail is verified.
DATA_ENCRYPTION_KEY=
# Vercel Cron sends it as a Bearer token to /api/cron/* (at least 16 characters). Without it the jobs refuse to run.
CRON_SECRET=
# Optional: debug / info / warn / error (default info).
LOG_LEVEL=
# Optional: call another deployment's Attende API over HTTP (base including /api) instead of this app's own routes.
ATTENDE_API_URL=

# JSYNQ, as seen by the Attende API: base URL (as the partner API expects it), partner key, per-call timeout in ms,
# and the secret that verifies X-Jsynq-Signature on /api/jsynq/webhooks and /api/jsynq/inbound.
JSYNQ_API_URL=
JSYNQ_PARTNER_API_KEY=
JSYNQ_TIMEOUT_MS=
JSYNQ_WEBHOOK_SECRET=

# Stripe (same account as JSYNQ; Attende products). Webhook endpoint: <origin>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: days of access after the paid period ends (default 3).
BILLING_GRACE_DAYS=

# OTP e-mail: log (dev only, prints the mail) / smtp / resend. SMTP_URL for smtp, RESEND_API_KEY for resend.
MAIL_PROVIDER=
MAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# Optional: model of the JSYNQ agents the Attende API creates (default gpt-4o-mini).
AGENT_MODEL=
# Optional: extra throwaway e-mail domains to refuse at signup (comma separated).
EXTRA_DISPOSABLE_DOMAINS=
# Worker only (phase 4): the advanced automations runtime. Not read by the Next.js routes.
ADVANCED_AUTOMATIONS_RUNTIME_ENABLED=

# --- JSYNQ API --------------------------------------------------------------
# Base URL of the JSYNQ API (including /api), used by server components, server actions and route handlers.
# The funnel (CRM board table) and the reports (conversation analytics) are read from it too.
BACKEND_URL=
# Same API, as seen from the browser (direct uploads, realtime). Inlined at build time.
NEXT_PUBLIC_BACKEND_URL=
# Optional: websocket origin; when empty it is derived from NEXT_PUBLIC_BACKEND_URL (http -> ws).
NEXT_PUBLIC_WEBSOCKET_SERVER=

# --- Sign-in (NextAuth / Auth.js) ------------------------------------------
# JSYNQ MongoDB connection string: the NextAuth adapter and a few server actions read it. Required at build time too.
MONGODB_URI=
# Encrypts the session cookie and signs the API token sent to the JSYNQ API. Must equal the secret the API verifies.
AUTH_SECRET=
# Optional: public base URL of this app (fallback for return URLs when the request has no host).
AUTH_URL=
# Optional: stable Auth.js URL Google redirects to before bouncing back (ends in /api/auth, no trailing slash).
AUTH_REDIRECT_PROXY_URL=
# Google sign-in (OAuth client of the JSYNQ project).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (Stripe) --------------------------------------------------------
# Browser key for Stripe Elements on the signup card step (same Stripe account as STRIPE_SECRET_KEY).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Feature flags (Statsig) -------------------------------------------------
# Server secret key; the root layout bootstraps the client flags with it (pages fail without a valid key).
STATSIG_SERVER_API_KEY=
# Optional: Statsig project id for the Flags SDK adapter.
STATSIG_PROJECT_ID=
# Browser client key.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
# Optional: environment tier (development / staging / production); defaults from VERCEL_ENV.
STATSIG_ENVIRONMENT=
NEXT_PUBLIC_STATSIG_ENVIRONMENT=

# --- WhatsApp embedded signup (Meta) -------------------------------------
# Meta app id for the Facebook JS SDK.
NEXT_PUBLIC_META_APP_ID=
# Embedded-signup configuration id in the Meta app.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional: Facebook Graph SDK version (e.g. v21.0).
NEXT_PUBLIC_META_SDK_VERSION=
# Optional: "1" logs WhatsApp QR session details outside development.
WHATSAPP_LITE_QR_DEBUG=

# --- Product links and limits ----------------------------------------------
# Optional: JSYNQ app URL shown in links (default https://app.jsynq.com).
NEXT_PUBLIC_JSYNQ_URL=
# Optional: contact e-mail shown in the app (default support@jsynq.com).
NEXT_PUBLIC_BOTS_CONTACT_EMAIL=
# Optional: booking link for a sales call (defaults to a JSYNQ booking page).
NEXT_PUBLIC_BOTS_BOOKING_URL=
# Optional: maximum upload size in MB for agent knowledge files (backend limit is 20 MB).
NEXT_PUBLIC_ATTENDE_UPLOAD_MAX_MB=

# --- Build ---------------------------------------------------------------------
# Optional: build into another folder (e.g. .next-build) so `next build` can run beside `next dev`.
NEXT_DIST_DIR=
